# SmartApply Configuration
PORT=5001
NODE_ENV=development
# Database. Leave MONGODB_URI empty (or remove it) to use the built-in database,
# which saves to server/data/db. For hosting online, use a MongoDB Atlas URI.
MONGODB_URI=
# Change this to a long random string
JWT_SECRET=change_me_to_a_long_random_secret

# First admin (admissions officer) account, created on startup if it does not exist.
# Students sign up themselves on the Register page.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Optional: college code the admin belongs to (AIT, MUSC, ZGSM ...)
ADMIN_COLLEGE_CODE=

# Set to true only if you want the old demo accounts and sample applications
SEED_DEMO_DATA=false
CLIENT_URL=http://localhost:5173

# Optional: lets the counsellor chatbot write AI answers (it works without this, using built-in answers)
# ANTHROPIC_API_KEY=
# COUNSELLOR_MODEL=claude-haiku-4-5-20251001
